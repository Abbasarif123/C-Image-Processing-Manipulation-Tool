{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(Debug) Read Input PPM",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/bin/convert",
      "args": [
        "read"
      ],
      "stdio": [
        "${workspaceFolder}/test/data/test.ppm",
        null,
        null
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "preLaunchTask": "build",
      "MIMode": "lldb"
    },
    {
      "name": "(Debug) Read and Write PPM",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/bin/convert",
      "args": [
        "read-and-write"
      ],
      "stdio": [
        "${workspaceFolder}/test/data/test.ppm",
        "${workspaceFolder}/out.ppm",
        null
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "preLaunchTask": "build",
      "MIMode": "lldb"
    },
