      "request": "launch",
      "program": "${workspaceFolder}/bin/convert",
      "args": [
        "gui"
      ],
      "stopAtEntry": true,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "lldb",
      "preLaunchTask": "buildGUI",
      "env": {
        "LSAN_OPTIONS": "detect_leaks=0"
      }
    },
    {
      "name": "(Opt) Launch GUI",
